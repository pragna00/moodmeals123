{
  "name": "moodmeals-expo",
  "version": "1.0.0",
  "main": "index.js",
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "^57.0.31",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-web": "^0.21.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "test:all": "node tests/runAllTests.js",
    "test:appium": "node -e \"require('./tests/appium/appiumTestSuite').runAppiumTestSuite()\"",
    "test:selenium": "node -e \"require('./tests/selenium/seleniumTestSuite').runSeleniumTestSuite()\"",
    "test:load": "node -e \"require('./tests/load/loadTestSuite').runLoadTestSuite()\""
  },
  "private": true,
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "exceljs": "^4.4.0",
    "selenium-webdriver": "^4.50.0",
    "webdriverio": "^10.0.0"
  }
}
